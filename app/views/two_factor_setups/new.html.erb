<% content_for :title, "2FA einrichten – Postview" %>

<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">2FA einrichten</h1>
    <p class="text-slate-500 text-sm mt-1">Schützen Sie Ihr Konto mit einer Authenticator-App</p>
  </div>

  <% if flash.now[:alert] %>
    <div class="mb-4 bg-red-50 border border-red-200 rounded-xl p-4">
      <p class="text-sm text-red-700"><%= flash.now[:alert] %></p>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-6">
    <!-- Step 1: Scan QR code -->
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="bg-sky-600 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">1</span>
        <h3 class="text-sm font-semibold text-slate-700">QR-Code scannen</h3>
      </div>
      <p class="text-sm text-slate-500 mb-4">
        Öffnen Sie Ihre Authenticator-App (Google Authenticator, Authy, 1Password etc.) und scannen Sie diesen QR-Code:
      </p>
      <div class="flex justify-center">
        <div class="bg-white p-3 rounded-xl border border-slate-200 inline-block">
          <%= raw @qr_code %>
        </div>
      </div>
    </div>

    <!-- Step 2: Manual entry -->
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="bg-slate-400 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">2</span>
        <h3 class="text-sm font-semibold text-slate-700">Oder manuell eingeben</h3>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 flex items-center justify-between">
        <code class="text-sm font-mono text-slate-700 break-all"><%= @otp_secret %></code>
        <button
          onclick="navigator.clipboard.writeText('<%= @otp_secret %>').then(() => this.textContent = 'Kopiert!')"
          class="ml-3 text-xs text-sky-600 hover:text-sky-500 font-medium shrink-0 transition-colors">
          Kopieren
        </button>
      </div>
    </div>

    <!-- Step 3: Verify -->
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="bg-sky-600 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">3</span>
        <h3 class="text-sm font-semibold text-slate-700">Code bestätigen</h3>
      </div>
      <p class="text-sm text-slate-500 mb-3">
        Geben Sie den 6-stelligen Code aus Ihrer App ein, um die Einrichtung zu bestätigen:
      </p>
      <%= form_with url: two_factor_setups_path, method: :post do |f| %>
        <div class="flex gap-3">
          <%= f.text_field :code,
              autofocus: true,
              autocomplete: "one-time-code",
              inputmode: "numeric",
              pattern: "[0-9 ]*",
              maxlength: 7,
              placeholder: "000 000",
              class: "flex-1 border border-slate-300 rounded-lg px-3 py-2.5 text-sm text-center text-xl tracking-widest font-mono focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent" %>
          <%= f.submit "Aktivieren",
              class: "bg-sky-600 hover:bg-sky-500 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors cursor-pointer text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-4 text-center">
    <%= link_to profile_path, class: "text-sm text-slate-400 hover:text-slate-600 transition-colors" do %>
      Abbrechen
    <% end %>
  </div>
</div>
