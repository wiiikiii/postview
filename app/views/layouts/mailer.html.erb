<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body { margin: 0; padding: 0; background: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .wrapper { max-width: 520px; margin: 40px auto; padding: 0 16px; }
      .card { background: #fff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; }
      .header { background: #0f172a; padding: 24px 32px; text-align: center; }
      .header-title { color: #fff; font-size: 18px; font-weight: 700; margin: 8px 0 0; }
      .header-sub { color: #94a3b8; font-size: 13px; margin: 4px 0 0; }
      .body { padding: 32px; }
      .greeting { font-size: 15px; color: #1e293b; margin: 0 0 16px; }
      .text { font-size: 14px; color: #475569; line-height: 1.6; margin: 0 0 24px; }
      .btn { display: inline-block; background: #0284c7; color: #fff !important; text-decoration: none;
             font-size: 14px; font-weight: 600; padding: 12px 28px; border-radius: 10px; }
      .btn:hover { background: #0369a1; }
      .btn-wrap { text-align: center; margin: 0 0 24px; }
      .divider { border: none; border-top: 1px solid #e2e8f0; margin: 24px 0; }
      .small { font-size: 12px; color: #94a3b8; line-height: 1.5; }
      .url { font-family: monospace; font-size: 11px; color: #64748b; word-break: break-all; }
      .footer { padding: 16px 32px 24px; text-align: center; }
      .footer-text { font-size: 12px; color: #94a3b8; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <div class="header">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="1.5" style="display:inline-block">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375"/>
          </svg>
          <div class="header-title">Postview</div>
          <div class="header-sub">PostgreSQL Datenbank-Viewer</div>
        </div>
        <div class="body">
          <%= yield %>
        </div>
        <div class="footer">
          <p class="footer-text">Postview &middot; Automatisch generierte E-Mail, bitte nicht antworten.</p>
        </div>
      </div>
    </div>
  </body>
</html>
