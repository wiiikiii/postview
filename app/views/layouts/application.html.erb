<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title><%= content_for(:title) || "Postview" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-prefetch" content="false">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="h-full">
    <div class="min-h-full">
      <nav class="bg-slate-800 border-b border-slate-700">
        <div class="max-w-full px-6">
          <div class="flex h-14 items-center justify-between">
            <div class="flex items-center gap-6">
              <%= link_to root_path, class: "flex items-center gap-2 group" do %>
                <svg class="h-5 w-5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 2.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m0 2.625c0 2.278 3.694 4.125 8.25 4.125s8.25-1.847 8.25-4.125" />
                </svg>
                <span class="text-white font-semibold tracking-wide group-hover:text-sky-300 transition-colors">Postview</span>
              <% end %>

              <% if content_for?(:breadcrumb) %>
                <div class="flex items-center gap-2 text-sm text-slate-400">
                  <%= yield :breadcrumb %>
                </div>
              <% end %>
            </div>

            <% if current_user %>
              <div class="flex items-center gap-3">
                <%= link_to profile_path, class: "flex items-center gap-1.5 text-slate-400 hover:text-sky-300 transition-colors text-sm" do %>
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                  <span><%= current_user.username %></span>
                <% end %>
                <%= button_to logout_path, method: :delete,
                    class: "text-slate-500 hover:text-red-400 transition-colors text-xs px-2 py-1 rounded border border-slate-600 hover:border-red-500/50" do %>
                  Abmelden
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </nav>

      <div class="fixed top-16 right-4 z-50 flex flex-col gap-2 w-80" aria-live="polite">
        <% if flash[:alert] %>
          <div data-controller="flash" class="flex items-start gap-3 rounded-xl border border-red-200 bg-white px-4 py-3 shadow-lg">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            <p class="text-sm text-red-700 break-all"><%= flash[:alert] %></p>
          </div>
        <% end %>
        <% if flash[:notice] %>
          <div data-controller="flash" class="flex items-start gap-3 rounded-xl border border-sky-200 bg-white px-4 py-3 shadow-lg">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-sky-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>
            <p class="text-sm text-sky-700 break-all"><%= flash[:notice] %></p>
          </div>
        <% end %>
      </div>

      <main class="<%= content_for?(:main_class) ? yield(:main_class) : 'py-6 px-6' %>">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
