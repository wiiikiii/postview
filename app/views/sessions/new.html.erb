<% content_for :title, "Anmelden – Postview" %>
<% content_for :main_class, "p-0" %>

<div class="min-h-screen bg-slate-900 flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-sm">
    <!-- Logo / Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-3">
        <div class="bg-sky-500/10 p-3 rounded-2xl border border-sky-500/20">
          <svg class="h-8 w-8 text-sky-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 2.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m0 2.625c0 2.278 3.694 4.125 8.25 4.125s8.25-1.847 8.25-4.125" />
          </svg>
        </div>
      </div>
      <h1 class="text-2xl font-bold text-white">Postview</h1>
      <p class="text-slate-400 text-sm mt-1">PostgreSQL Datenbank-Viewer</p>
    </div>

    <!-- Flash messages -->
    <% if flash[:alert] %>
      <div class="mb-4 bg-red-500/10 border border-red-500/20 rounded-xl p-3">
        <p class="text-sm text-red-400"><%= flash[:alert] %></p>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="mb-4 bg-green-500/10 border border-green-500/20 rounded-xl p-3">
        <p class="text-sm text-green-400"><%= flash[:notice] %></p>
      </div>
    <% end %>

    <!-- Login form -->
    <div class="bg-slate-800 rounded-2xl border border-slate-700 p-6 shadow-xl">
      <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
        <% if flash.now[:alert] %>
          <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-3">
            <p class="text-sm text-red-400"><%= flash.now[:alert] %></p>
          </div>
        <% end %>

        <div>
          <label for="username" class="block text-sm font-medium text-slate-300 mb-1.5">Benutzername</label>
          <%= f.text_field :username,
              id: "username",
              autofocus: true,
              autocomplete: "username",
              class: "w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent text-sm",
              placeholder: "benutzername" %>
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-slate-300 mb-1.5">Passwort</label>
          <%= f.password_field :password,
              id: "password",
              autocomplete: "current-password",
              class: "w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent text-sm",
              placeholder: "••••••••" %>
        </div>

        <%= f.submit "Anmelden",
            class: "w-full bg-sky-600 hover:bg-sky-500 text-white font-semibold py-2.5 px-4 rounded-lg transition-colors cursor-pointer text-sm" %>
      <% end %>

      <div class="mt-4 pt-4 border-t border-slate-700 text-center">
        <%= link_to new_magic_link_path, class: "text-sm text-slate-400 hover:text-sky-400 transition-colors" do %>
          <span>Mit Magic Link anmelden</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
